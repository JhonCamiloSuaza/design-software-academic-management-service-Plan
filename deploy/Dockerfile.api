FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml ./
COPY academic-core/pom.xml academic-core/pom.xml
COPY academic-adapters/pom.xml academic-adapters/pom.xml
COPY academic-management-api/pom.xml academic-management-api/pom.xml
RUN mvn -q -DskipTests dependency:go-offline
COPY academic-core academic-core
COPY academic-adapters academic-adapters
COPY academic-management-api academic-management-api
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/academic-management-api/target/academic-management-api-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8003
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
